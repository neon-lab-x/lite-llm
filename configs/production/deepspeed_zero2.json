{
    "bf16": {
        "enabled": "auto"
    },
    "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
            "device": "none"
        },
        "offload_param": {
            "device": "none"
        },
        "allgather_partitions": true,
        "overlap_comm": true,
        "reduce_scatter": true,
        "contiguous_gradients": true
    },
    "gradient_accumulation_steps": "auto",
    "gradient_clipping": "auto",
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": "auto",
    "data_efficiency": {
        "enabled": false
    },
    "pipeline": {
        "enabled": false
    },
    "tensorboard": {
        "enabled": true,
        "output_path": "./artifacts/production/logs"
    },
    "wall_clock_breakdown": false
}
